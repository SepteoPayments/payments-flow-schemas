{
  "name": "@septeo-payments/payments-flow-schemas",
  "version": "0.1.0",
  "description": "Composant React (schémas de flux interactifs de l'API publique de paiement Septeo) à intégrer dans le BO — Intégration › Documentation API Public.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/flowSchemas.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/Septeo-Paiement/septeo-payment/_packaging/septeo-payment-feed/npm/registry/"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "license": "UNLICENSED"
}
